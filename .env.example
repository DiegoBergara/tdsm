# Required: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Required: Comma-separated Telegram user IDs allowed to use the bot
ALLOWED_USER_IDS=

# Optional: SQLite database path (default: ./data/tdsm.db)
DATABASE_PATH=./data/tdsm.db

# Optional: Log level - DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Optional: Default number of lines for /logs and capture (default: 50)
DEFAULT_LOG_LINES=50
